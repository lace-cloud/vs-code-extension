{
  "schema_version": "1.0",
  "kind": "module_bundle",
  "entry": {
    "module_id": "simple-role-with-policy",
    "version": "v1.0.0"
  },
  "modules": {
    "simple-role-with-policy@v1.0.0": {
      "schema_version": "1.0",
      "kind": "module_def",
      "id": "simple-role-with-policy",
      "version": "v1.0.0",
      "description": "Simple IAM role with attached policy",
      "interface": {
        "inputs": [
          {
            "name": "role_name",
            "type": "string",
            "required": true,
            "description": "Name of the IAM role"
          },
          {
            "name": "policy_name",
            "type": "string",
            "required": true,
            "description": "Name of the IAM policy"
          },
          {
            "name": "assume_role_policy",
            "type": "string",
            "required": true,
            "description": "Trust policy for the IAM role (JSON)"
          },
          {
            "name": "policy_document",
            "type": "string",
            "required": true,
            "description": "IAM policy document (JSON)"
          },
          {
            "name": "tags",
            "type": "map(string)",
            "required": false,
            "description": "Tags for resources",
            "default": {}
          }
        ],
        "outputs": [
          {
            "name": "role_arn",
            "type": "string",
            "description": "ARN of the IAM role"
          },
          {
            "name": "role_name",
            "type": "string",
            "description": "Name of the IAM role"
          },
          {
            "name": "policy_arn",
            "type": "string",
            "description": "ARN of the IAM policy"
          }
        ]
      },
      "impl": {
        "kind": "composite",
        "graph": {
          "instances": [
            {
              "id": "role",
              "use": {
                "module_id": "aws/iam/role",
                "version": "v1.0.0"
              },
              "inputs": {
                "name": { "var": "role_name" },
                "assume_role_policy": { "var": "assume_role_policy" },
                "tags": { "var": "tags" }
              }
            },
            {
              "id": "policy",
              "use": {
                "module_id": "aws/iam/policy",
                "version": "v1.0.0"
              },
              "inputs": {
                "policy_name": { "var": "policy_name" },
                "policy_document": { "var": "policy_document" },
                "tags": { "var": "tags" }
              }
            },
            {
              "id": "attachment",
              "use": {
                "module_id": "aws/iam/policy_attachment",
                "version": "v1.0.0"
              },
              "inputs": {
                "role_name": { "out": { "module": "role", "name": "role_name" } },
                "policy_arn": { "out": { "module": "policy", "name": "policy_arn" } }
              }
            }
          ],
          "wires": [
            {
              "from": { "module": "role", "port": "outputs.role_name" },
              "to": { "module": "attachment", "port": "inputs.role_name" }
            },
            {
              "from": { "module": "policy", "port": "outputs.policy_arn" },
              "to": { "module": "attachment", "port": "inputs.policy_arn" }
            }
          ],
          "exports": {
            "outputs": {
              "role_arn": { "out": { "module": "role", "name": "role_arn" } },
              "role_name": { "out": { "module": "role", "name": "role_name" } },
              "policy_arn": { "out": { "module": "policy", "name": "policy_arn" } }
            }
          }
        }
      }
    },
    "aws/iam/role@v1.0.0": {
      "schema_version": "1.0",
      "kind": "module_def",
      "id": "aws/iam/role",
      "version": "v1.0.0",
      "description": "AWS IAM Role leaf module",
      "interface": {
        "inputs": [
          {
            "name": "name",
            "type": "string",
            "required": true,
            "description": "The name of the IAM role"
          },
          {
            "name": "assume_role_policy",
            "type": "string",
            "required": true,
            "description": "The assume role policy document (JSON string)"
          },
          {
            "name": "tags",
            "type": "map(string)",
            "required": false,
            "description": "A map of tags to assign to the role",
            "default": {}
          }
        ],
        "outputs": [
          {
            "name": "role_name",
            "type": "string",
            "description": "The name of the IAM role"
          },
          {
            "name": "role_arn",
            "type": "string",
            "description": "The ARN of the IAM role"
          }
        ]
      },
      "impl": {
        "kind": "leaf",
        "source": {
          "kind": "git",
          "repo": "https://github.com/lace-cloud/registry-tf.git",
          "subdir": "modules/aws/iam/role",
          "ref": "v1.0.0"
        }
      }
    },
    "aws/iam/policy@v1.0.0": {
      "schema_version": "1.0",
      "kind": "module_def",
      "id": "aws/iam/policy",
      "version": "v1.0.0",
      "description": "AWS IAM Policy leaf module",
      "interface": {
        "inputs": [
          {
            "name": "policy_name",
            "type": "string",
            "required": true,
            "description": "The name of the IAM policy"
          },
          {
            "name": "policy_document",
            "type": "string",
            "required": true,
            "description": "The IAM policy document (JSON string)"
          },
          {
            "name": "tags",
            "type": "map(string)",
            "required": false,
            "description": "A map of tags to assign to the IAM policy",
            "default": {}
          }
        ],
        "outputs": [
          {
            "name": "policy_arn",
            "type": "string",
            "description": "The ARN of the IAM policy"
          }
        ]
      },
      "impl": {
        "kind": "leaf",
        "source": {
          "kind": "git",
          "repo": "https://github.com/lace-cloud/registry-tf.git",
          "subdir": "modules/aws/iam/policy",
          "ref": "v1.0.0"
        }
      }
    },
    "aws/iam/policy_attachment@v1.0.0": {
      "schema_version": "1.0",
      "kind": "module_def",
      "id": "aws/iam/policy_attachment",
      "version": "v1.0.0",
      "description": "AWS IAM Role Policy Attachment leaf module",
      "interface": {
        "inputs": [
          {
            "name": "role_name",
            "type": "string",
            "required": true,
            "description": "The name of the IAM role to attach the policy to"
          },
          {
            "name": "policy_arn",
            "type": "string",
            "required": true,
            "description": "The ARN of the IAM policy to attach"
          }
        ],
        "outputs": [
          {
            "name": "attachment_id",
            "type": "string",
            "description": "The ID of the IAM role policy attachment"
          }
        ]
      },
      "impl": {
        "kind": "leaf",
        "source": {
          "kind": "git",
          "repo": "https://github.com/lace-cloud/registry-tf.git",
          "subdir": "modules/aws/iam/policy_attachment",
          "ref": "v1.0.0"
        }
      }
    }
  }
}