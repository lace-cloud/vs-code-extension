{
  "$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!out",
      "!dist",
      "!data",
      "!.vscode",
      "!packages/*/dist",
      "!packages/*/src/generated",
      "!package-lock.json",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "recommended": false
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@connectrpc/connect": "Extension shell uses gRPC-JS via @lace-cloud/host's LaceTransport, not Connect-Web.",
                  "@connectrpc/connect-web": "Extension shell uses gRPC-JS via @lace-cloud/host's LaceTransport, not Connect-Web."
                }
              }
            }
          }
        }
      }
    }
  ]
}
