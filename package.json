{
  "name": "lace",
  "displayName": "lace",
  "description": "",
  "version": "0.0.5",
  "publisher": "LaceCloudInc",
  "repository": {
    "type": "git",
    "url": "https://github.com/lace-cloud/vs-code-extension"
  },
  "icon": "Lace_Logo.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "laceContainer",
          "title": "Lace",
          "icon": "images/lace_logo.svg"
        }
      ]
    },
    "views": {
      "laceContainer": [
        {
          "id": "laceRegistry",
          "name": "Registry",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "lace.openCanvas",
        "title": "Lace: Open Canvas"
      },
      {
        "command": "lace.addModule",
        "title": "Lace: Add Module to Canvas"
      },
      {
        "command": "lace.generate",
        "title": "Lace: Generate Terraform"
      },
      {
        "command": "lace.refreshRegistry",
        "title": "Refresh Registry",
        "icon": "$(refresh)"
      },
      {
        "command": "lace.startEngine",
        "title": "Lace: Start Engine"
      },
      {
        "command": "lace.stopEngine",
        "title": "Lace: Stop Engine"
      },
      {
        "command": "lace.restartEngine",
        "title": "Lace: Restart Engine"
      },
      {
        "command": "lace.terraformValidate",
        "title": "Lace: Terraform Validate"
      },
      {
        "command": "lace.terraformFmt",
        "title": "Lace: Terraform Format"
      },
      {
        "command": "lace.terraformScan",
        "title": "Lace: Terraform Security Scan"
      },
      {
        "command": "lace.terraformDocs",
        "title": "Lace: Terraform Docs"
      }
    ],
    "configuration": {
      "title": "Lace",
      "properties": {
        "lace.binaryPath": {
          "type": "string",
          "default": "/usr/local/bin/lace",
          "description": "Path to the lace CLI binary"
        },
        "lace.autoStart": {
          "type": "boolean",
          "default": true
        },
        "lace.autoRestart": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "lace.refreshRegistry",
          "when": "view == laceRegistry",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "rspack --config rspack.config.js",
    "pretest": "npm run compile",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'src/webview/__tests__/e2e-*'",
    "test:e2e": "vitest run src/webview/__tests__/e2e-*",
    "test:watch": "vitest",
    "build": "rspack --config rspack.config.js",
    "watch": "rspack --watch --config rspack.config.js",
    "package": "vsce package",
    "prepare": "husky"
  },
  "devDependencies": {
    "@rspack/cli": "^1.1.8",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.95.0",
    "@vitest/ui": "^3.0.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "css-loader": "^7.1.2",
    "file-loader": "^6.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.8.1",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.1.18",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@xyflow/react": "^12.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
