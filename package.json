{
  "name": "lace-cloud",
  "displayName": "Lace Cloud",
  "description": "",
  "version": "0.0.31",
  "packageManager": "pnpm@10.29.3",
  "publisher": "LaceCloudInc",
  "repository": {
    "type": "git",
    "url": "https://github.com/lace-cloud/vs-code-extension"
  },
  "license": "BUSL-1.1",
  "icon": "Lace_Logo.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "enabledApiProposals": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "laceContainer",
          "title": "Lace",
          "icon": "images/lace_logo.svg"
        }
      ]
    },
    "views": {
      "laceContainer": [
        {
          "id": "laceRegistry",
          "name": "Registry",
          "type": "webview"
        },
        {
          "id": "laceChat",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "lace.openCanvas",
        "title": "Lace: Open Canvas"
      },
      {
        "command": "lace.addModule",
        "title": "Lace: Add Module to Canvas"
      },
      {
        "command": "lace.generate",
        "title": "Lace: Generate Terraform"
      },
      {
        "command": "lace.refreshRegistry",
        "title": "Refresh Registry",
        "icon": "$(refresh)"
      },
      {
        "command": "lace.startEngine",
        "title": "Lace: Start Engine"
      },
      {
        "command": "lace.stopEngine",
        "title": "Lace: Stop Engine"
      },
      {
        "command": "lace.restartEngine",
        "title": "Lace: Restart Engine"
      },
      {
        "command": "lace.refreshCanvasModules",
        "title": "Lace: Refresh Canvas Modules",
        "icon": "$(refresh)"
      },
      {
        "command": "lace.terraformValidate",
        "title": "Lace: Terraform Validate"
      },
      {
        "command": "lace.terraformFmt",
        "title": "Lace: Terraform Format"
      },
      {
        "command": "lace.terraformScan",
        "title": "Lace: Terraform Security Scan"
      },
      {
        "command": "lace.terraformDocs",
        "title": "Lace: Terraform Docs"
      },
      {
        "command": "lace.openLogs",
        "title": "Lace: Open Logs"
      },
      {
        "command": "lace.clearChatHistory",
        "title": "Lace: Clear Chat History"
      }
    ],
    "configuration": {
      "title": "Lace",
      "properties": {
        "lace.binaryPath": {
          "type": "string",
          "default": "/usr/local/bin/lace",
          "description": "Path to the lace CLI binary"
        },
        "lace.autoStart": {
          "type": "boolean",
          "default": true
        },
        "lace.autoRestart": {
          "type": "boolean",
          "default": true
        },
        "lace.autoSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically save canvas changes. When disabled, use Cmd+S to save manually."
        },
        "lace.chatProactivity": {
          "type": "string",
          "enum": [
            "off",
            "on"
          ],
          "default": "on",
          "description": "Enable rule-based suggestions when state changes between chat turns."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "lace.refreshRegistry",
          "when": "view == laceRegistry",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "compile": "rspack --config rspack.config.js",
    "pretest": "npm run compile",
    "format": "biome format --write",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:host-e2e": "pnpm --filter @lace-cloud/host-e2e test",
    "test:watch": "vitest",
    "lint": "biome check",
    "build": "rspack --config rspack.config.js",
    "watch": "rspack --watch --config rspack.config.js",
    "package": "vsce package",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@rspack/cli": "^1.1.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.95.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "css-loader": "^7.1.2",
    "file-loader": "^6.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.1",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3",
    "vitest": "~3.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.6",
    "@lace-cloud/canvas": "0.1.1-next.24828814947",
    "@lace-cloud/chat-core": "0.1.1-next.24828814947",
    "@lace-cloud/chat-sidebar": "workspace:*",
    "@lace-cloud/chat-webview": "0.1.1-next.24828814947",
    "@lace-cloud/design-tokens": "0.1.1-next.24828814947",
    "@lace-cloud/host": "0.1.1-next.24828814947",
    "@lace-cloud/proto": "0.1.1-next.24828814947",
    "@lace-cloud/ui": "0.1.1-next.24828814947",
    "@xyflow/react": "^12.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs"
    ]
  }
}
