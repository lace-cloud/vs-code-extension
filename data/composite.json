                                        "name": "rule_name"
                                    }
                                }
                            }
                        },
                        "instances": [
                            {
                                "id": "event_queue",
                                "inputs": {
                                    "message_retention_seconds": {
                                        "var": "message_retention_seconds"
                                    },
                                    "name": {
                                        "expr": {
                                            "lang": "hcl",
                                            "value": "\"${var.name}-queue\""
                                        }
                                    },
                                    "tags": {
                                        "var": "tags"
                                    },
                                    "visibility_timeout_seconds": {
                                        "var": "visibility_timeout"
                                    }
                                },
                                "use": {
                                    "module_id": "modules/aws/sqs/queue",
                                    "version": "v1.0.0"
                                }
                            },
                            {
                                "id": "log_group",
                                "inputs": {
                                    "name": {
                                        "expr": {
                                            "lang": "hcl",
                                            "value": "\"/aws/eventbridge/${var.name}\""
                                        }
                                    },
                                    "retention_in_days": {
                                        "var": "log_retention_days"
                                    },
                                    "tags": {
                                        "var": "tags"
                                    }
                                },
                                "use": {
                                    "module_id": "modules/aws/cloudwatch/log_group",
                                    "version": "v1.0.0"
                                }
                            },
                            {
                                "depends_on": [
                                    "aws_sqs_queue_policy.eventbridge_send"
                                ],
                                "id": "rule",
                                "inputs": {
                                    "description": {
                                        "var": "rule_description != \"\" ? var.rule_description : \"EventBridge rule for ${var.name}\""
                                    },
                                    "event_pattern": {
                                        "var": "event_pattern"
                                    },
                                    "name": {
                                        "expr": {
                                            "lang": "hcl",
                                            "value": "\"${var.name}-rule\""
                                        }
                                    },
                                    "schedule_expression": {
                                        "var": "schedule_expression"
                                    },
                                    "tags": {
                                        "var": "tags"
                                    },
                                    "targets": {
                                        "expr": {
                                            "lang": "hcl",
                                            "value": "[\n    {\n      arn       = module.event_queue.queue_arn\n      target_id = \"${var.name}-sqs-target\"\n    }\n  ]"
                                        }
                                    }
                                },
                                "use": {
                                    "module_id": "modules/aws/eventbridge/rule",
                                    "version": "v1.0.0"
                                }
                            },
                            {
                                "id": "resource.aws_sqs_queue_policy.eventbridge_send",
                                "inputs": {
                                    "policy": {
                                        "expr": {
                                            "lang": "hcl",
                                            "value": "jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [\n      {\n        Sid    = \"AllowEventBridgeSend\"\n        Effect = \"Allow\"\n        Principal = {\n          Service = \"events.amazonaws.com\"\n        }\n        Action   = \"sqs:SendMessage\"\n        Resource = module.event_queue.queue_arn\n        Condition = {\n          ArnEquals = {\n            \"aws:SourceArn\" = module.rule.rule_arn\n          }\n        }\n      }\n    ]\n  })"
                                        }
                                    },
                                    "queue_url": {
                                        "out": {
                                            "module": "event_queue",
                                            "name": "queue_url"
                                        }
                                    }
                                },
                                "kind": "resource",
                                "type": "aws_sqs_queue_policy"
                            }
                        ],
                        "wires": [
                            {
                                "from": {
                                    "module": "event_queue",
                                    "port": "outputs.queue_url"
                                },
                                "to": {
                                    "module": "resource.aws_sqs_queue_policy.eventbridge_send",
                                    "port": "inputs.queue_url"
                                }
                            }
                        ]
                    },
                    "kind": "composite"
                },
