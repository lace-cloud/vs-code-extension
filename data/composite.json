    "description": "Composite module that creates an EventBridge rule (schedule or event pattern), an SQS queue as the target, and a CloudWatch log group for observability. Includes the SQS resource policy required for EventBridge delivery.",
    "example": "# Scheduled rule — runs every 5 minutes\nmodule \"heartbeat_queue\" {\n  source  = \"git::https://github.com/lace-cloud/registry-tf.git//composites/eventbridge_scheduled_sqs?ref=v1.0.0\"\n\n  name                = \"heartbeat\"\n  schedule_expression = \"rate(5 minutes)\"\n  log_retention_days  = 7\n  tags = {\n    Team = \"platform\"\n  }\n}\n\n# Event pattern rule — captures all S3 PutObject events\nmodule \"s3_events_queue\" {\n  source  = \"git::https://github.com/lace-cloud/registry-tf.git//composites/eventbridge_scheduled_sqs?ref=v1.0.0\"\n\n  name = \"s3-put-events\"\n  event_pattern = jsonencode({\n    source      = [\"aws.s3\"]\n    detail-type = [\"Object Created\"]\n  })\n  tags = {\n    Team = \"data\"\n  }\n}\n",
    "git_tag": "eventbridge-scheduled-sqs/v1.0.0",
    "git_url": "git::https://github.com/lace-cloud/registry-tf.git//modules/aws/eventbridge/scheduled_sqs?ref=d783b3aad93fd4553b6fde790a6a2c3c45246957",
    "id": "879c4aa4-6952-43f1-87e7-575af1b5a150",
