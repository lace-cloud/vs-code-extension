{
  "schema_version": "1.0",
  "kind": "module_bundle",
  "entry": {
    "module_id": "iam-stack",
    "version": "v1.0.0"
  },
  "modules": {
    "iam-stack@v1.0.0": {
      "schema_version": "1.0",
      "kind": "module_def",
      "id": "iam-stack",
      "version": "v1.0.0",
      "description": "IAM role with policies for application access",
      "interface": {
        "inputs": [
          {
            "name": "role_name",
            "type": "string",
            "required": true,
            "description": "Name of the IAM role"
          },
          {
            "name": "environment",
            "type": "string",
            "required": true,
            "description": "Deployment environment"
          },
          {
            "name": "max_session_duration",
            "type": "number",
            "description": "Maximum session duration in seconds",
            "default": 3600,
            "validation": {
              "condition": "var.max_session_duration >= 3600 && var.max_session_duration <= 43200",
              "error_message": "Session duration must be between 3600 and 43200 seconds."
            }
          },
          {
            "name": "tags",
            "type": "map(string)",
            "description": "Tags for all resources",
            "default": {}
          }
        ],
        "outputs": [
          { "name": "role_arn", "type": "string", "description": "The ARN of the IAM role" },
          { "name": "role_name", "type": "string", "description": "The name of the IAM role" },
          {
            "name": "policy_arn",
            "type": "string",
            "description": "The ARN of the attached policy",
            "sensitive": true
          }
        ]
      },
      "terraform": {
        "required_version": ">= 1.5",
        "required_providers": {
          "aws": {
            "source": "hashicorp/aws",
            "version": "~> 5.0"
          }
        },
        "backend": {
          "type": "s3",
          "config": {
            "bucket": "my-terraform-state",
            "key": "iam-stack/terraform.tfstate",
            "region": "us-east-1",
            "encrypt": true
          }
        }
      },
      "providers": [
        {
          "name": "aws",
          "config": {
            "region": "us-east-1"
          }
        },
        {
          "name": "aws",
          "alias": "west",
          "config": {
            "region": "us-west-2"
          }
        }
      ],
      "impl": {
        "kind": "composite",
        "graph": {
          "instances": [
            {
              "id": "iam_role",
              "use": { "module_id": "aws-iam-role", "version": "v2.0.0" },
              "inputs": {
                "role_name": { "var": "role_name" },
                "assume_role_policy": {
                  "expr": {
                    "lang": "hcl",
                    "value": "jsonencode({Version = \"2012-10-17\", Statement = [{Effect = \"Allow\", Principal = {Service = \"lambda.amazonaws.com\"}, Action = \"sts:AssumeRole\"}]})"
                  }
                },
                "max_session_duration": { "var": "max_session_duration" },
                "tags": { "expr": { "lang": "hcl", "value": "merge(var.tags, local.common_tags)" } }
              }
            },
            {
              "id": "iam_policy",
              "use": { "module_id": "aws-iam-policy", "version": "v1.0.0" },
              "inputs": {
                "policy_name": {
                  "expr": { "lang": "hcl", "value": "\"${var.role_name}-policy\"" }
                },
                "policy_document": {
                  "expr": {
                    "lang": "hcl",
                    "value": "jsonencode({Version = \"2012-10-17\", Statement = [{Effect = \"Allow\", Action = [\"logs:CreateLogGroup\", \"logs:CreateLogStream\", \"logs:PutLogEvents\"], Resource = \"arn:aws:logs:*:*:*\"}]})"
                  }
                },
                "tags": { "var": "tags" }
              }
            },
            {
              "id": "iam_policy_attachment",
              "use": { "module_id": "aws-iam-role-policy-attachment", "version": "v1.0.0" },
              "inputs": {
                "role_name": { "out": { "module": "iam_role", "name": "role_name" } },
                "policy_arn": { "out": { "module": "iam_policy", "name": "arn" } }
              },
              "depends_on": ["module.iam_role", "module.iam_policy"]
            }
          ],
          "wires": [
            {
              "from": { "module": "iam_role", "port": "outputs.role_name" },
              "to": { "module": "iam_policy_attachment", "port": "inputs.role_name" }
            },
            {
              "from": { "module": "iam_policy", "port": "outputs.arn" },
              "to": { "module": "iam_policy_attachment", "port": "inputs.policy_arn" }
            }
          ],
          "exports": {
            "outputs": {
              "role_arn": { "out": { "module": "iam_role", "name": "arn" } },
              "role_name": { "out": { "module": "iam_role", "name": "role_name" } },
              "policy_arn": { "out": { "module": "iam_policy", "name": "arn" } }
            }
          },
          "locals": [
            {
              "name": "common_tags",
              "value": { "lit": { "ManagedBy": "lace", "Stack": "iam-stack" } }
            },
            {
              "name": "full_role_name",
              "value": {
                "expr": { "lang": "hcl", "value": "\"${var.environment}-${var.role_name}\"" }
              }
            }
          ]
        }
      }
    },
    "aws-iam-role@v2.0.0": {
      "schema_version": "1.0",
      "kind": "module_def",
      "id": "aws-iam-role",
      "version": "v2.0.0",
      "description": "Creates an IAM role",
      "interface": {
        "inputs": [
          { "name": "role_name", "type": "string", "required": true },
          { "name": "assume_role_policy", "type": "string", "required": true },
          { "name": "max_session_duration", "type": "number" },
          { "name": "tags", "type": "map(string)" }
        ],
        "outputs": [
          { "name": "arn", "type": "string" },
          { "name": "role_name", "type": "string" },
          { "name": "unique_id", "type": "string" }
        ]
      },
      "impl": {
        "kind": "leaf",
        "source": {
          "kind": "git",
          "repo": "https://github.com/example/terraform-aws-iam-role.git",
          "ref": "v2.0.0"
        }
      }
    },
    "aws-iam-policy@v1.0.0": {
      "schema_version": "1.0",
      "kind": "module_def",
      "id": "aws-iam-policy",
      "version": "v1.0.0",
      "description": "Creates an IAM policy",
      "interface": {
        "inputs": [
          { "name": "policy_name", "type": "string", "required": true },
          { "name": "policy_document", "type": "string", "required": true },
          { "name": "tags", "type": "map(string)" }
        ],
        "outputs": [
          { "name": "arn", "type": "string" },
          { "name": "policy_name", "type": "string" }
        ]
      },
      "impl": {
        "kind": "leaf",
        "source": {
          "kind": "git",
          "repo": "https://github.com/example/terraform-aws-iam-policy.git",
          "ref": "v1.0.0"
        }
      }
    },
    "aws-iam-role-policy-attachment@v1.0.0": {
      "schema_version": "1.0",
      "kind": "module_def",
      "id": "aws-iam-role-policy-attachment",
      "version": "v1.0.0",
      "description": "Attaches an IAM policy to an IAM role",
      "interface": {
        "inputs": [
          { "name": "role_name", "type": "string", "required": true },
          { "name": "policy_arn", "type": "string", "required": true }
        ],
        "outputs": []
      },
      "impl": {
        "kind": "leaf",
        "source": {
          "kind": "git",
          "repo": "https://github.com/example/terraform-aws-iam-role-policy-attachment.git",
          "ref": "v1.0.0"
        }
      }
    }
  },
  "environments": {
    "dev": {
      "role_name": "dev-lambda-role",
      "environment": "dev",
      "max_session_duration": 3600,
      "tags": { "Environment": "dev", "Team": "platform" }
    },
    "prod": {
      "role_name": "prod-lambda-role",
      "environment": "prod",
      "max_session_duration": 7200,
      "tags": { "Environment": "prod", "Team": "platform", "Compliance": "soc2" }
    }
  },
  "environment_backends": {
    "dev": {
      "type": "s3",
      "config": {
        "bucket": "my-state-dev",
        "key": "iam-stack/terraform.tfstate",
        "region": "us-east-1",
        "encrypt": true
      }
    },
    "prod": {
      "type": "s3",
      "config": {
        "bucket": "my-state-prod",
        "key": "iam-stack/terraform.tfstate",
        "region": "us-east-1",
        "encrypt": true,
        "dynamodb_table": "terraform-locks"
      }
    }
  }
}
