{
  "schema_version": "1.0",
  "kind": "module_bundle",
  "entry": {
    "module_id": "iam-stack",
    "version": "v1.0.0"
  },
  "modules": {
    "iam-stack@v1.0.0": {
      "schema_version": "1.0",
      "kind": "module_def",
      "id": "iam-stack",
      "version": "v1.0.0",
      "description": "IAM role with CloudWatch logs policy",
      "interface": {
        "inputs": [
          {
            "name": "role_name",
            "type": "string",
            "required": true,
            "description": "IAM role name to create"
          },
          {
            "name": "assume_role_policy",
            "type": "string",
            "required": true,
            "description": "Trust policy for the IAM role"
          },
          { "name": "tags", "type": "map(string)", "description": "Tags for the IAM role" }
        ],
        "outputs": [
          { "name": "role_name", "type": "string", "description": "The name of the IAM role" },
          { "name": "role_arn", "type": "string", "description": "The ARN of the IAM role" },
          {
            "name": "policy_arn",
            "type": "string",
            "description": "The ARN of the attached policy"
          }
        ]
      },
      "graph": {
        "instances": [
          {
            "id": "iam_role",
            "kind": "module",
            "use": { "module_id": "aws-iam-role", "version": "v1.0.0" },
            "inputs": {
              "name": { "var": "role_name" },
              "assume_role_policy": { "var": "assume_role_policy" },
              "tags": { "var": "tags" }
            }
          },
          {
            "id": "cloudwatch_logs_policy",
            "kind": "module",
            "use": { "module_id": "cloudwatch-logs-policy", "version": "v1.0.0" },
            "inputs": {
              "role_name": { "out": { "module": "iam_role", "name": "role_name" } },
              "policy_name": { "lit": "cloudwatch-logs" },
              "actions": {
                "lit": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"]
              },
              "resources": { "lit": ["*"] }
            }
          }
        ],
        "wires": [
          {
            "from": { "module": "iam_role", "port": "outputs.role_name" },
            "to": { "module": "cloudwatch_logs_policy", "port": "inputs.role_name" }
          }
        ],
        "exports": {
          "outputs": {
            "role_name": { "out": { "module": "iam_role", "name": "role_name" } },
            "role_arn": { "out": { "module": "iam_role", "name": "role_arn" } },
            "policy_arn": { "out": { "module": "cloudwatch_logs_policy", "name": "policy_arn" } }
          }
        }
      }
    },
    "cloudwatch-logs-policy@v1.0.0": {
      "schema_version": "1.0",
      "kind": "module_def",
      "id": "cloudwatch-logs-policy",
      "version": "v1.0.0",
      "description": "CloudWatch Logs IAM policy with role attachment",
      "interface": {
        "inputs": [
          {
            "name": "role_name",
            "type": "string",
            "required": true,
            "description": "IAM role name to attach the policy to"
          },
          {
            "name": "policy_name",
            "type": "string",
            "required": true,
            "description": "Name of the IAM policy"
          },
          {
            "name": "actions",
            "type": "list(string)",
            "required": true,
            "description": "IAM actions for this policy"
          },
          {
            "name": "resources",
            "type": "list(string)",
            "required": true,
            "description": "IAM resource ARNs"
          }
        ],
        "outputs": [
          { "name": "policy_arn", "type": "string", "description": "ARN of the policy created" }
        ]
      },
      "graph": {
        "instances": [
          {
            "id": "policy",
            "kind": "module",
            "use": { "module_id": "aws-iam-policy", "version": "v1.0.0" },
            "inputs": {
              "policy_name": { "var": "policy_name" },
              "policy_document": {
                "expr": {
                  "lang": "hcl",
                  "value": "jsonencode({Version = \"2012-10-17\", Statement = [{Effect = \"Allow\", Action = var.actions, Resource = var.resources}]})"
                }
              }
            }
          },
          {
            "id": "attachment",
            "kind": "module",
            "use": { "module_id": "aws-iam-policy-attachment", "version": "v1.0.0" },
            "inputs": {
              "role_name": { "var": "role_name" },
              "policy_arn": { "out": { "module": "policy", "name": "policy_arn" } }
            }
          }
        ],
        "wires": [
          {
            "from": { "module": "policy", "port": "outputs.policy_arn" },
            "to": { "module": "attachment", "port": "inputs.policy_arn" }
          }
        ],
        "exports": {
          "outputs": {
            "policy_arn": { "out": { "module": "policy", "name": "policy_arn" } }
          }
        }
      }
    },
    "aws-iam-role@v1.0.0": {
      "schema_version": "1.0",
      "kind": "module_def",
      "id": "aws-iam-role",
      "version": "v1.0.0",
      "description": "Creates an IAM role",
      "interface": {
        "inputs": [
          {
            "name": "name",
            "type": "string",
            "required": true,
            "description": "Name of the IAM role"
          },
          {
            "name": "assume_role_policy",
            "type": "string",
            "required": true,
            "description": "Trust policy JSON"
          },
          { "name": "tags", "type": "map(string)", "description": "Tags for the role" }
        ],
        "outputs": [
          { "name": "role_name", "type": "string", "description": "The name of the role" },
          { "name": "role_arn", "type": "string", "description": "The ARN of the role" }
        ]
      },
      "source": {
        "kind": "git",
        "repo": "https://github.com/lace-cloud/registry-tf.git",
        "subdir": "aws/iam/role",
        "ref": "v1.0.0"
      },
      "graph": {
        "instances": [],
        "exports": { "outputs": {} }
      }
    },
    "aws-iam-policy@v1.0.0": {
      "schema_version": "1.0",
      "kind": "module_def",
      "id": "aws-iam-policy",
      "version": "v1.0.0",
      "description": "Creates an IAM policy",
      "interface": {
        "inputs": [
          {
            "name": "policy_name",
            "type": "string",
            "required": true,
            "description": "Name of the policy"
          },
          {
            "name": "policy_document",
            "type": "string",
            "required": true,
            "description": "Policy document JSON"
          },
          { "name": "tags", "type": "map(string)", "description": "Tags for the policy" }
        ],
        "outputs": [
          { "name": "policy_arn", "type": "string", "description": "The ARN of the policy" }
        ]
      },
      "source": {
        "kind": "git",
        "repo": "https://github.com/lace-cloud/registry-tf.git",
        "subdir": "aws/iam/policy",
        "ref": "v1.0.0"
      },
      "graph": {
        "instances": [],
        "exports": { "outputs": {} }
      }
    },
    "aws-iam-policy-attachment@v1.0.0": {
      "schema_version": "1.0",
      "kind": "module_def",
      "id": "aws-iam-policy-attachment",
      "version": "v1.0.0",
      "description": "Attaches an IAM policy to a role",
      "interface": {
        "inputs": [
          {
            "name": "role_name",
            "type": "string",
            "required": true,
            "description": "IAM role name"
          },
          {
            "name": "policy_arn",
            "type": "string",
            "required": true,
            "description": "Policy ARN to attach"
          }
        ],
        "outputs": [
          { "name": "attachment_id", "type": "string", "description": "The attachment identifier" }
        ]
      },
      "source": {
        "kind": "git",
        "repo": "https://github.com/lace-cloud/registry-tf.git",
        "subdir": "aws/iam/policy_attachment",
        "ref": "v1.0.0"
      },
      "graph": {
        "instances": [],
        "exports": { "outputs": {} }
      }
    }
  }
}
